                android:paddingTop="20px"
                android:visibility="gone"
                style="@style/FsH38" />

            <!-- 常驻按钮行：与主界面同款同坐标（264×56 @x49 / x327，行 y270） -->
            <LinearLayout android:id="@+id/pairing_buttons"
                android:layout_width="wrap_content"
                android:layout_height="56px"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="270px"
                android:orientation="horizontal">

                <TextView android:id="@+id/btn_pairing_left"
                    android:layout_width="264px"
                    android:layout_height="56px"
                    android:background="@drawable/btn_dialog"
                    android:gravity="center"
                    android:text="热点信息"
                    style="@style/PfT42" />

                <TextView android:id="@+id/btn_pairing_right"
                    android:layout_width="264px"
                    android:layout_height="56px"
                    android:layout_marginLeft="14px"
                    android:background="@drawable/btn_dialog"
                    android:gravity="center"
                    android:text="服务状态"
                    style="@style/PfT42" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="52px"
            android:background="@drawable/bg_footer52"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="10px">
            <!-- 按键引导（用户要求加上）：垃圾桶键 = 打开选项菜单（与主界面同款），
                 MENU 键帽 + 后面那块 = MENU 的实际作用。
                 ★ 配对页的 MENU **两种语义**（用户定版，判据是"谁把用户带进来的"）：
                   · 应用自动进的（本机没有已配对设备 → 配对页就是这一态的家）
                     → MENU = 退出软件，后面那块是"退出"两个字；
                   · 用户自己在菜单里点"进入配对模式"进来的（本机有设备）
                     → MENU = 返回刚才那一屏（选项菜单），后面那块是返回箭头。
