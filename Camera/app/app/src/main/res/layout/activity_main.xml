<?xml version="1.0" encoding="utf-8"?>



















<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff000000">

    




    <LinearLayout android:id="@+id/screen_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include android:id="@+id/header_main" layout="@layout/screen_header" />

        

        <FrameLayout android:id="@+id/main_body"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1">

            
            <RelativeLayout android:id="@+id/main_block_diagram"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                



                <ImageView android:id="@+id/main_icon_left"
                    android:layout_width="140px"
                    android:layout_height="140px"
                    android:layout_marginLeft="80px"
                    android:layout_marginTop="34px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_sync_camera_off" />

                
                <ImageView android:id="@+id/main_icon_dots"
                    android:layout_width="180px"
                    android:layout_height="40px"
                    android:layout_marginLeft="230px"
                    android:layout_marginTop="91px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_sync_link_off" />

                
                <ImageView android:id="@+id/main_icon_phone"
                    android:layout_width="140px"
                    android:layout_height="140px"
                    android:layout_marginLeft="420px"
                    android:layout_marginTop="34px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_sync_phone_off" />

                


                <TextView android:id="@+id/main_cap_left"
                    android:layout_width="240px"
                    android:layout_height="46px"
                    android:layout_marginLeft="28px"
                    android:layout_marginTop="185px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:gravity="center"
                    style="@style/PfT42" />

                <TextView android:id="@+id/main_cap_right"
                    android:layout_width="240px"
                    android:layout_height="46px"
                    android:layout_marginLeft="370px"
                    android:layout_marginTop="185px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:gravity="center"
                    style="@style/PfT42" />
            </RelativeLayout>

            
            <RelativeLayout android:id="@+id/main_block_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                


                <ImageView android:id="@+id/qr_view"
                    android:layout_width="160px"
                    android:layout_height="213px"
                    android:layout_marginTop="14px"
                    android:layout_centerHorizontal="true"
                    android:background="#ffffffff"
                    android:scaleType="fitCenter" />

                <TextView android:id="@+id/qr_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="232px"
                    android:layout_centerHorizontal="true"
                    android:text="扫码加入热点"
                    style="@style/PfT26D" />
            </RelativeLayout>

            





            <TextView android:id="@+id/status_view"
                android:layout_width="match_parent"
                android:layout_height="260px"
                android:paddingLeft="28px"
                android:paddingTop="20px"
                style="@style/FsH38" />

            
            <LinearLayout android:id="@+id/main_buttons"
                android:layout_width="wrap_content"
                android:layout_height="56px"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="270px"
                android:orientation="horizontal">

                <TextView android:id="@+id/btn_main_left"
                    android:layout_width="264px"
                    android:layout_height="56px"
                    android:background="@drawable/btn_dialog"
                    android:gravity="center"
                    android:text="显示二维码"
                    style="@style/PfT42" />

                <TextView android:id="@+id/btn_main_right"
                    android:layout_width="264px"
                    android:layout_height="56px"
                    android:layout_marginLeft="14px"
                    android:background="@drawable/btn_dialog"
                    android:gravity="center"
                    android:text="服务状态"
                    style="@style/PfT42" />
            </LinearLayout>

            









            <ImageView android:id="@+id/main_glow"
                android:layout_width="640px"
                android:layout_height="298px"
                android:layout_gravity="bottom|left"
                android:scaleType="fitXY"
                android:src="@drawable/ic_sync_glow" />
        </FrameLayout>

        
        <LinearLayout android:id="@+id/main_footer"
            android:layout_width="match_parent"
            android:layout_height="52px"
            android:background="@drawable/bg_footer52"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="10px">

            <TextView android:id="@+id/footer_key_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE800;"
                style="@style/PfTIcon" />

            <TextView android:id="@+id/footer_text_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6px"
                android:text="选项"
                style="@style/PfT36" />

            <TextView android:id="@+id/footer_key_main_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18px"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6px"
                android:text="退出"
                style="@style/PfT36" />
        </LinearLayout>
    </LinearLayout>

    




    <LinearLayout android:id="@+id/screen_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <include android:id="@+id/header_menu" layout="@layout/screen_header" />

        




        <FrameLayout android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1">

            <ListView android:id="@+id/menu_list"
                android:layout_width="606px"
                android:layout_height="302px"
                android:layout_marginLeft="17px"
                android:layout_marginTop="30px"
                android:divider="@drawable/h_divider"
                android:dividerHeight="2px"
                android:listSelector="@android:color/transparent"
                android:cacheColorHint="#00000000"
                android:fadingEdge="none"
                android:scrollbars="none" />
        </FrameLayout>

        


        <LinearLayout android:layout_width="match_parent"
            android:layout_height="52px"
            android:background="@drawable/bg_footer52"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="10px">
            <TextView android:id="@+id/footer_key_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />
            <TextView android:id="@+id/footer_key_menu_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2px"
                android:text="&#xE803;"
                style="@style/PfTIcon" />
        </LinearLayout>
    </LinearLayout>

    



    <LinearLayout android:id="@+id/screen_paired"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <include android:id="@+id/header_paired" layout="@layout/screen_header" />

        <FrameLayout android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1">

            <ListView android:id="@+id/paired_list"
                android:layout_width="606px"
                android:layout_height="302px"
                android:layout_marginLeft="17px"
                android:layout_marginTop="30px"
                android:divider="@drawable/h_divider"
                android:dividerHeight="2px"
                android:listSelector="@android:color/transparent"
                android:cacheColorHint="#00000000"
                android:fadingEdge="none"
                android:scrollbars="none" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="52px"
            android:background="@drawable/bg_footer52"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="10px">
            <TextView android:id="@+id/footer_key_paired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE801;"
                style="@style/PfTIcon" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6px"
                android:text="解除配对"
                style="@style/PfT36" />
            <TextView android:id="@+id/footer_key_paired_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18px"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />
            <TextView android:id="@+id/footer_key_paired_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2px"
                android:text="&#xE803;"
                style="@style/PfTIcon" />
        </LinearLayout>
    </LinearLayout>

    










    <FrameLayout android:id="@+id/screen_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim_panel" />

        <RelativeLayout android:layout_width="match_parent"
            android:layout_height="match_parent">

            
            <View android:id="@+id/mode_panel"
                android:layout_width="518px"
                android:layout_height="480px"
                android:layout_marginLeft="62px"
                android:background="@drawable/set_panel" />

            
            <TextView android:layout_width="wrap_content"
                android:layout_height="46px"
                android:layout_marginLeft="13px"
                android:layout_marginTop="29px"
                android:layout_alignLeft="@id/mode_panel"
                android:layout_alignTop="@id/mode_panel"
                android:gravity="center_vertical|left"
                android:text="连接设置"
                style="@style/PfT42" />

            
            <ListView android:id="@+id/mode_list"
                android:layout_width="489px"
                android:layout_height="302px"
                android:layout_marginLeft="20px"
                android:layout_marginTop="95px"
                android:layout_alignLeft="@id/mode_panel"
                android:layout_alignTop="@id/mode_panel"
                android:paddingRight="11px"
                android:divider="@drawable/h_divider"
                android:dividerHeight="2px"
                android:listSelector="@android:color/transparent"
                android:cacheColorHint="#00000000"
                android:fadingEdge="none"
                android:scrollbars="none" />

            
            <LinearLayout android:layout_width="500px"
                android:layout_height="40px"
                android:layout_marginLeft="70px"
                android:layout_marginTop="413px"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">
                <TextView android:id="@+id/footer_key_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#xE80A;"
                    style="@style/PfTIcon" />
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2px"
                    android:text="&#xE803;"
                    style="@style/PfTIcon" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    








    <LinearLayout android:id="@+id/screen_pairing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <include android:id="@+id/header_pairing" layout="@layout/screen_header" />

        <FrameLayout android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView android:id="@+id/pairing_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- - - - - -"
                    style="@style/PfH52" />

                
                <TextView android:id="@+id/pairing_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26px"
                    android:text=""
                    style="@style/PfT44" />

                <TextView android:id="@+id/pairing_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16px"
                    android:text="在手机端输入配对码"
                    style="@style/PfT34D" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="52px"
            android:background="@drawable/bg_footer52"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="10px">
            



            <TextView android:id="@+id/footer_key_pairing_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE800;"
                style="@style/PfTIcon" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6px"
                android:text="选项"
                style="@style/PfT36" />
            <TextView android:id="@+id/footer_key_pairing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18px"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2px"
                android:text="&#xE803;"
                style="@style/PfTIcon" />
        </LinearLayout>
    </LinearLayout>

    
    <LinearLayout android:id="@+id/screen_about"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <include android:id="@+id/header_about" layout="@layout/screen_header" />

        






        <FrameLayout android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                
                <TextView android:id="@+id/about_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="SonyConnect 2.0"
                    style="@style/PfH42" />

                
                <TextView android:id="@+id/about_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26px"
                    android:gravity="center"
                    android:text="配套手机端 SonyConnect 2.0 使用&#10;开发者：BI2QFA"
                    style="@style/PfH38" />

                
                <TextView android:id="@+id/about_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26px"
                    android:gravity="center"
                    android:text="本机设备码：00000000"
                    style="@style/PfH38" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="52px"
            android:background="@drawable/bg_footer52"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="10px">
            <TextView android:id="@+id/footer_key_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2px"
                android:text="&#xE803;"
                style="@style/PfTIcon" />
        </LinearLayout>
    </LinearLayout>

    






    




    <LinearLayout android:id="@+id/screen_log"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <include android:id="@+id/header_log" layout="@layout/screen_header" />

        <ScrollView android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:paddingLeft="8px"
            android:paddingRight="8px"
            android:paddingTop="4px">

            <TextView android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/FsH26" />
        </ScrollView>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="52px"
            android:background="@drawable/bg_footer52"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="10px">
            

            <TextView android:id="@+id/footer_key_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2px"
                android:text="&#xE803;"
                style="@style/PfTIcon" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/dlg_exit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_40"
        android:visibility="gone">

        <RelativeLayout android:layout_width="600px"
            android:layout_height="416px"
            android:layout_marginLeft="20px"
            android:layout_marginTop="4px"
            android:layout_gravity="top|left"
            android:background="@drawable/dlg_area">

            

            <ImageView android:id="@+id/dlg_exit_warn"
                android:layout_width="60px"
                android:layout_height="60px"
                android:layout_marginLeft="270px"
                android:layout_marginTop="16px"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitXY"
                android:src="@drawable/dlg_warn" />

            <TextView android:id="@+id/exit_msg"
                android:layout_width="544px"
                android:layout_height="180px"
                android:layout_marginLeft="28px"
                android:layout_marginTop="76px"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:gravity="center"
                android:text="确定要退出 SonyConnect 吗？"
                style="@style/PfH38" />

            <TextView android:id="@+id/btn_exit_ok"
                android:layout_width="240px"
                android:layout_height="56px"
                android:layout_marginLeft="180px"
                android:layout_marginTop="270px"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_dialog"
                android:gravity="center"
                android:text="确定"
                style="@style/PfT42" />

            <TextView android:id="@+id/btn_exit_cancel"
                android:layout_width="240px"
                android:layout_height="56px"
                android:layout_marginLeft="180px"
                android:layout_marginTop="336px"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_dialog"
                android:gravity="center"
                android:text="取消"
                style="@style/PfT42" />
        </RelativeLayout>

        
        <LinearLayout android:layout_width="640px"
            android:layout_height="60px"
            android:layout_gravity="bottom|left"
            android:background="@drawable/dlg_footer"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="8px">
            <TextView android:id="@+id/footer_key_dlg_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2px"
                android:text="&#xE803;"
                style="@style/PfTIcon" />
        </LinearLayout>
    </FrameLayout>

    
    <FrameLayout android:id="@+id/dlg_default"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_40"
        android:visibility="gone">

        <RelativeLayout android:layout_width="600px"
            android:layout_height="416px"
            android:layout_marginLeft="20px"
            android:layout_marginTop="4px"
            android:layout_gravity="top|left"
            android:background="@drawable/dlg_area">

            <TextView android:id="@+id/default_msg"
                android:layout_width="544px"
                android:layout_height="180px"
                android:layout_marginLeft="28px"
                android:layout_marginTop="76px"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:gravity="center"
                android:text="将此连接方式设为默认？"
                style="@style/PfH38" />

            <TextView android:id="@+id/btn_default_ok"
                android:layout_width="240px"
                android:layout_height="56px"
                android:layout_marginLeft="180px"
                android:layout_marginTop="270px"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_dialog"
                android:gravity="center"
                android:text="设为默认"
                style="@style/PfT42" />

            <TextView android:id="@+id/btn_default_no"
                android:layout_width="240px"
                android:layout_height="56px"
                android:layout_marginLeft="180px"
                android:layout_marginTop="336px"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_dialog"
                android:gravity="center"
                android:text="仅本次"
                style="@style/PfT42" />
        </RelativeLayout>

        <LinearLayout android:layout_width="640px"
            android:layout_height="60px"
            android:layout_gravity="bottom|left"
            android:background="@drawable/dlg_footer"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:paddingRight="8px">
            <TextView android:id="@+id/footer_key_dlg_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xE80A;"
                style="@style/PfTIcon" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2px"
                android:text="&#xE803;"
                style="@style/PfTIcon" />
        </LinearLayout>
    </FrameLayout>

    
















    <FrameLayout android:id="@+id/dlg_exiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ff000000"
        android:visibility="gone">

        <View android:id="@+id/exit_frame"
            android:layout_width="576px"
            android:layout_height="400px"
            android:layout_marginLeft="32px"
            android:layout_marginTop="9px"
            android:background="@drawable/panel_frame" />

        



        <TextView android:id="@+id/exit_ing_msg"
            android:layout_width="640px"
            android:layout_height="48px"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="150px"
            android:gravity="center"
            android:text="正在退出···"
            style="@style/PfH38" />
    </FrameLayout>
</FrameLayout>
