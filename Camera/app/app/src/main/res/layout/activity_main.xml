                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- - - - - -"
                    style="@style/PfH52" />

                <!-- 倒计时：28px 灰（font_invalid 是原厂的"次要信息"色 #777777） -->
                <TextView android:id="@+id/pairing_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26px"
                    android:text=""
                    style="@style/PfT44" />

                <TextView android:id="@+id/pairing_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16px"
                    android:text="在手机端输入配对码"
                    style="@style/PfT34D" />
            </LinearLayout>

            <!-- ② 热点信息：几何与主界面那块**逐像素相同**（同一块 640×480 屏） -->
            <RelativeLayout android:id="@+id/pairing_block_hotspot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <TextView android:id="@+id/pairing_hot_name"
                    android:layout_width="400px"
                    android:layout_height="44px"
                    android:layout_marginLeft="24px"
                    android:layout_marginTop="76px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:text="热点名称：—"
                    style="@style/PfT32" />

                <TextView android:id="@+id/pairing_hot_pass"
                    android:layout_width="400px"
                    android:layout_height="44px"
                    android:layout_marginLeft="24px"
                    android:layout_marginTop="136px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:text="热点密码：—"
                    style="@style/PfT32" />

                <ImageView android:id="@+id/pairing_qr_view"
                    android:layout_width="160px"
                    android:layout_height="213px"
                    android:layout_marginLeft="452px"
                    android:layout_marginTop="24px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="#ffffffff"
                    android:scaleType="fitCenter" />

                <TextView android:id="@+id/pairing_qr_caption"
                    android:layout_width="160px"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="452px"
                    android:layout_marginTop="240px"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:gravity="center"
                    android:text="扫码加入热点"
                    style="@style/PfT26D" />
            </RelativeLayout>

            <!-- ③ 服务状态：与主界面同一份正文（buildMainStatusText()），
                 区别只有状态行末尾那个"（配对模式）"。 -->
            <TextView android:id="@+id/pairing_status"
