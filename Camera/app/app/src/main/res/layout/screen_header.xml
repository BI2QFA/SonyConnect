<?xml version="1.0" encoding="utf-8"?>

















<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="66px"
    android:background="@drawable/bg_header66"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    





    <ImageView android:id="@+id/app_icon"
        android:layout_width="70px"
        android:layout_height="55px"
        android:layout_marginLeft="6px"
        android:scaleType="fitXY"
        android:src="@drawable/ic_appicon" />

    
    <TextView android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="46px"
        android:layout_marginLeft="2px"
        android:gravity="center_vertical|left"
        android:text="SonyConnect"
        style="@style/PfT42" />

    <View android:layout_width="0px"
        android:layout_height="1px"
        android:layout_weight="1" />

    



    <ImageView android:id="@+id/wifi_icon"
        android:layout_width="48px"
        android:layout_height="32px"
        android:layout_marginRight="8px"
        android:scaleType="fitXY"
        android:src="@drawable/ic_wifi_header"
        android:visibility="gone" />

    <LinearLayout android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12px"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PfT28" />

        <ImageView android:id="@+id/battery_icon"
            android:layout_width="37px"
            android:layout_height="32px"
            android:layout_marginLeft="8px"
            android:scaleType="fitXY"
            android:src="@drawable/bat_4" />
    </LinearLayout>
</LinearLayout>
